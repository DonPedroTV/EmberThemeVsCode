          "comment.doc": { "color": "#697482", "font_style": "italic" },
          "constant": { "color": "#c792ea" },
          "constructor": { "color": "#ceb478" },
          "embedded": { "color": "#c9c4ba" },
          "emphasis": { "color": "#d5d0c5", "font_style": "italic" },
          "emphasis.strong": { "color": "#e5dfd2", "font_weight": 700 },
          "enum": { "color": "#ceb478" },
          "function": { "color": "#83b7c6" },
          "function.method": { "color": "#83b7c6" },
          "hint": { "color": "#83c5b2" },
          "keyword": { "color": "#ca8d78" },
          "label": { "color": "#91c0cf" },
          "link_text": { "color": "#78b9d6" },
          "link_uri": { "color": "#78b9d6" },
          "number": { "color": "#c792ea" },
          "operator": { "color": "#999f97" },
          "predictive": { "color": "#787f78", "font_style": "italic" },
          "preproc": { "color": "#c58bc3" },
          "primary": { "color": "#c9c4ba" },
          "property": { "color": "#95b8c8" },
