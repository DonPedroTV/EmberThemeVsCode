{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Ember Theme",
  "author": "DonPedroTV",
  "themes": [
    {
      "name": "Ember Theme",
      "appearance": "dark",
      "style": {
        "background": "#1b1b1a",
